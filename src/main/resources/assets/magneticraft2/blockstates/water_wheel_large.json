{
  "multipart": [
    {
      "when": {
        "active": "false",
        "facing": "east"
      },
      "apply": {
        "model": "magneticraft2:block/water_wheel_large"
      }
    },
    {
      "when": {
        "active": "false",
        "facing": "west"
      },
      "apply": {
        "model": "magneticraft2:block/water_wheel_large"
      }
    },
    {
      "when": {
        "active": "false",
        "facing": "north"
      },
      "apply": {
        "model": "magneticraft2:block/water_wheel_large",
        "y": 90
      }
    },
    {
      "when": {
        "active": "false",
        "facing": "south"
      },
      "apply": {
        "model": "magneticraft2:block/water_wheel_large",
        "y": 90
      }
    }
  ]
}
